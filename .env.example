# Copy to .env for local `vercel dev` / `npm run dev:www` (sites/www proxy only).
# Production: set these on the Vercel project for sites/www (subdomains call crown.com.vn/api cross-origin).
# Token must stay server-side — never expose in static HTML/JS.

CONSULTATION_LEADS_API_URL=http://localhost:4000
CONSULTATION_LEADS_API_TOKEN=your-bearer-token