{
  "name": "crown-marketing",
  "private": true,
  "description": "Static marketing sites for Crown — one Vercel project per subdomain",
  "scripts": {
    "dev": "node scripts/dev-help.mjs",
    "dev:www": "node scripts/dev-www.mjs",
    "dev:www:static": "serve sites/www -l 5000",
    "dev:www:vercel": "npx vercel dev sites/www --listen 5000",
    "dev:audit": "serve sites/audit -l 5001",
    "dev:cons": "serve sites/cons -l 5002",
    "dev:acc": "serve sites/acc -l 5003",
    "dev:tax": "serve sites/tax -l 5004",
    "dev:fas": "serve sites/fas -l 5005",
    "dev:esg": "serve sites/esg -l 5006",
    "dev:up": "serve sites/up -l 5007",
    "deploy": "node scripts/deploy-help.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:www": "node scripts/deploy-site.mjs www",
    "deploy:audit": "node scripts/deploy-site.mjs audit",
    "deploy:cons": "node scripts/deploy-site.mjs cons",
    "deploy:acc": "node scripts/deploy-site.mjs acc",
    "deploy:tax": "node scripts/deploy-site.mjs tax",
    "deploy:fas": "node scripts/deploy-site.mjs fas",
    "deploy:esg": "node scripts/deploy-site.mjs esg",
    "deploy:up": "node scripts/deploy-site.mjs up",
    "prepare:deploy": "node scripts/prepare-deploy.mjs",
    "prepare:deploy:fast": "node scripts/prepare-deploy.mjs all --fast",
    "release": "node scripts/deploy-all.mjs",
    "release:preview": "node scripts/deploy-all.mjs --preview",
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "sync:team-modal": "node scripts/patch-team-member-modal.mjs",
    "sync:consultation": "node scripts/sync-consultation-leads.mjs",
    "sync:enquiry-modals": "node scripts/patch-enquiry-modals.mjs",
    "sync:images": "node scripts/extract-data-uri-images.mjs all",
    "locale:build": "node scripts/prerender-locale.mjs all",
    "seo:apply": "node scripts/patch-locale-switcher.mjs && node scripts/prerender-locale.mjs all && node scripts/apply-seo.mjs all && node scripts/seo/legacy-redirects.mjs",
    "seo:verify": "node scripts/seo/verify-local.mjs",
    "test:locale-path": "node scripts/seo/locale-path.test.mjs",
    "seo:check": "node scripts/seo/check-local.mjs",
    "seo:check:live": "node scripts/seo/check-live.mjs",
    "seo:gsc": "node scripts/seo/search-console-sitemaps.mjs"
  },
  "devDependencies": {
    "googleapis": "^190.0.0",
    "linkedom": "^0.18.15",
    "serve": "^14.2.4",
    "vercel": "^67.0.0"
  }
}
