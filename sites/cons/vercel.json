{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash ../../scripts/should-build.sh",
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
