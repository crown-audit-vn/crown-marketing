{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash ../../scripts/should-build.sh",
  "redirects": [
    {
      "source": "/en",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "vi"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "vi"
        }
      ],
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "vi"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "vi"
        }
      ],
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
